{
  "name": "prizma-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prizma — bright, offline-first cross-platform calendar",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
